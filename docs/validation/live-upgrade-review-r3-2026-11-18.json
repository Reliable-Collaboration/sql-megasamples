    {
      "id": "S1",
      "proof": "Native host initial-namespace guard; no unshare walk. Final native proof with all existing stacks up. Native namespace/mount reads succeed for host and owned-rootless processes; descriptor limits remain named.",
      "tests": [
        "test_scan_rejects_child_user_namespace"
      ]
    },
    {
      "id": "S2",
      "proof": "comm/PID/owner/operation/error for unreadable rows; other owners separately counted. Decision covers inspectable operations only; no certification of inaccessible operations.",
      "tests": [
        "test_named_unreadable_operation_is_reported_not_whole_host_refusal",
        "test_unresolved_owner_is_named_without_certifying_it",
        "test_other_owner_not_an_unreadable_own_process"
      ]
    },
    {
      "id": "S3",
      "proof": "Recorded source device/root comparison, nonroot filesystems, private /asound skip; unresolved mount on source device refuses, including a whole root.",
      "tests": [
        "test_private_asound_device_is_unrelated",
        "test_mount_resolution_only_refuses_source_device",
        "test_unresolvable_whole_root_on_source_device_refuses"
      ]
    },
    {
      "id": "S4",
      "proof": "Zombies, exited and vanished tasks have classes. All 18 persistent retained FileNotFoundError entries verified as zombies: 16 python, 1 docker, 1 dpkg-preconfigu. Current proof also counts a further zombie.",
      "tests": [
        "test_dead_process_has_class_before_namespace_read",
        "test_vanished_task_is_classified"
      ]
    },
    {
      "id": "S5",
      "proof": "Prefix helpers attributed by retained non-host namespace, open namespace FD or specific container cgroup. Shared host/service groups cannot attribute. Active isolated-stack scan: deployment and outside helpers separately counted.",
      "tests": [
        "test_helper_requires_recorded_network_or_container_cgroup",
        "test_deployment_helper_attribution_alternatives",
        "test_shared_host_network_and_service_cgroup_do_not_attribute_helper",
        "test_stopped_or_removed_snapshot_retains_helper_attribution"
      ]
    },
    {
      "id": "S6",
      "proof": "Each refusal has comm, PID, owner, holds and reason. Current runbook gives an action for each reason; permission limits/new task races are distinct.",
      "tests": [
        "test_container_namespace_path_holds_recorded_source",
        "test_mount_resolution_only_refuses_source_device",
        "test_helper_requires_recorded_network_or_container_cgroup"
      ]
    },
